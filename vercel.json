{
    "version": 2,
    "builds": [
        {
            "src": "server-standalone.js",
            "use": "@vercel/node"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/server-standalone.js"
        },
        {
            "src": "/(.*\\.(css|js|jpg|png|svg|webp|ico|json))",
            "dest": "/$1"
        },
        {
            "src": "/(.*\\.html)",
            "dest": "/$1"
        },
        {
            "src": "/",
            "dest": "/server-standalone.js"
        },
        {
            "src": "/(.*)",
            "dest": "/server-standalone.js"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    }
}